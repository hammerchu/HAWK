<?xml version="1.0"?>
<robot name="gcr16_2000" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- CAD-pose check: every STL stays in STEP world frame; joints are fixed at origin. -->
  <xacro:arg name="use_cad_meshes" default="true"/>
  <xacro:arg name="mesh_dir" default=""/>
  <xacro:include filename="gcr16_common.xacro"/>

  <xacro:property name="use_cad" value="$(arg use_cad_meshes)"/>
  <xacro:property name="mesh_dir" value="$(arg mesh_dir)"/>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:gcr16_cad_or_dummy
      link_name="base_link" stl_name="GCR16-J0.stl"
      dummy_xyz="0 0 0.08" dummy_size="0.22 0.22 0.16"
      use_cad_meshes="${use_cad}" mesh_dir="${mesh_dir}"/>
  </link>

  <xacro:macro name="fixed_cad_link" params="parent child stl dummy_xyz dummy_size">
    <joint name="${child}_fixed" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${child}">
      <xacro:gcr16_cad_or_dummy
        link_name="${child}" stl_name="${stl}"
        dummy_xyz="${dummy_xyz}" dummy_size="${dummy_size}"
        use_cad_meshes="${use_cad}" mesh_dir="${mesh_dir}"/>
    </link>
  </xacro:macro>

  <xacro:fixed_cad_link parent="base_link" child="gcr16_link1" stl="GCR16-J1.stl"
    dummy_xyz="0 0 0.25" dummy_size="0.14 0.14 0.18"/>
  <xacro:fixed_cad_link parent="gcr16_link1" child="gcr16_link2" stl="GCR16-J2.stl"
    dummy_xyz="0 0 0.70" dummy_size="0.12 0.12 0.70"/>
  <xacro:fixed_cad_link parent="gcr16_link2" child="gcr16_link3" stl="GCR16-J3.stl"
    dummy_xyz="0 0 1.30" dummy_size="0.11 0.11 0.50"/>
  <xacro:fixed_cad_link parent="gcr16_link3" child="gcr16_link4" stl="GCR16-J4.stl"
    dummy_xyz="0 0 1.65" dummy_size="0.10 0.10 0.20"/>
  <xacro:fixed_cad_link parent="gcr16_link4" child="gcr16_link5" stl="GCR16-J5.stl"
    dummy_xyz="0 0 1.85" dummy_size="0.09 0.09 0.18"/>
  <xacro:fixed_cad_link parent="gcr16_link5" child="gcr16_link6" stl="GCR16-J6.stl"
    dummy_xyz="0 0 2.00" dummy_size="0.08 0.08 0.10"/>
</robot>
